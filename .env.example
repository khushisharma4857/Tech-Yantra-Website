# Copy to .env and fill in. Never commit the real .env.
#
# IMPORTANT: anything prefixed VITE_ is inlined into the public JavaScript
# bundle and is readable by anyone who views the site. Only put values here
# that are safe to expose, and restrict them by domain in the provider's
# dashboard. Never put a private/server API key in a VITE_ variable.

# Contact form provider key - see the TODO block in src/components/ContactForm.jsx
VITE_WEB3FORMS_KEY=
